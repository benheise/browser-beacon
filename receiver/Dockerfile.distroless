# syntax=docker/dockerfile:1
#
# browser-beacon receiver on Google Distroless (Debian 13, Node.js 26 LTS, nonroot). No shell.
#   docker build -f Dockerfile.distroless -t browser-beacon-receiver:1.0.0-distroless .
#
# The base image is pinned by digest so builds are repeatable:
#   gcr.io/distroless/nodejs26-debian13:nonroot (Node 26.13.0), digest taken 2026-11-01.
# Distroless images are rebuilt as Debian and Node publish fixes. Refresh the digest on a schedule:
#   docker buildx imagetools inspect gcr.io/distroless/nodejs26-debian13:nonroot
ARG NODE_IMAGE=gcr.io/distroless/nodejs26-debian13:nonroot@sha256:9b945e92c1b5463a4b75f11e8417515e4bea7355f6adfd79ec220fbbe905dda8

# ---- 1. test: the image is only produced if the tests pass --------------------------
FROM ${NODE_IMAGE} AS test
WORKDIR /src
COPY server.js ./
COPY test/ ./test/
RUN ["/nodejs/bin/node", "--check", "server.js"]
RUN ["/nodejs/bin/node", "--test", "test/receiver.test.js"]
# Empty log directory to copy into the runtime image with the right owner.
RUN ["/nodejs/bin/node", "-e", "require('fs').mkdirSync('/tmp/logdir')"]

# ---- 2. runtime ----------------------------------------------------------------------
FROM ${NODE_IMAGE}
LABEL org.opencontainers.image.title="browser-beacon-receiver" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.description="Receives browser-beacon reports, keeps those from allowed IP ranges, writes daily JSON Lines logs"
# Code owned by root and read-only; only the log directory is writable by the service user.
# WORKDIR first so /app is created 0755 (COPY --chmod would also apply 0444 to a new parent).
WORKDIR /app
COPY --chown=0:0 --chmod=0444 server.js /app/server.js
COPY --from=test --chown=65532:65532 --chmod=0750 /tmp/logdir /var/log/browser-beacon
USER 65532:65532
ENV NODE_ENV=production \
    PORT=8080 \
    LOG_DIR=/var/log/browser-beacon
EXPOSE 8080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/nodejs/bin/node", "/app/server.js", "--healthcheck"]
# The base image's entrypoint is /nodejs/bin/node.
CMD ["/app/server.js"]
